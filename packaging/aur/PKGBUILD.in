# Maintainer: ermoluk <88516629+ermoluk@users.noreply.github.com>
# Rendered by packaging/render.sh from the release's SHA256SUMS.
pkgname=mcp-warden-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Local-first credential broker MCP server for AI coding agents (prebuilt binary)"
arch=('x86_64' 'aarch64')
url="https://github.com/ermoluk/mcp-warden"
license=('Apache-2.0')
provides=('mcp-warden')
conflicts=('mcp-warden')
options=('!strip' '!debug')
source_x86_64=("mcp-warden-$pkgver-x86_64.tar.gz::$url/releases/download/v$pkgver/mcp-warden-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("mcp-warden-$pkgver-aarch64.tar.gz::$url/releases/download/v$pkgver/mcp-warden-aarch64-unknown-linux-musl.tar.gz")
sha256sums_x86_64=('@SHA256:mcp-warden-x86_64-unknown-linux-musl.tar.gz@')
sha256sums_aarch64=('@SHA256:mcp-warden-aarch64-unknown-linux-musl.tar.gz@')

package() {
  install -Dm755 mcp-warden "$pkgdir/usr/bin/mcp-warden"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
