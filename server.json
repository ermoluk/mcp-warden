{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.ermoluk/mcp-warden",
  "title": "mcp-warden",
  "description": "Local credential broker: agents call APIs, SSH and DBs via scoped presets; secrets stay in keychain.",
  "version": "0.5.2",
  "repository": {
    "url": "https://github.com/ermoluk/mcp-warden",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "cargo",
      "identifier": "mcp-warden",
      "version": "0.5.2",
      "transport": { "type": "stdio" },
      "packageArguments": [
        { "type": "positional", "value": "mcp" }
      ]
    }
  ]
}
